{
  "name": "monerod_module",
  "display_name": "Monero Node (local)",
  "version": "0.1.0",
  "type": "core",
  "interface": "universal",
  "transport": "qt_remote_plain",
  "concurrency": "multi",
  "category": "wallet",
  "description": "Runs a Monero node in-process: per-network config, start, stop, status and log tail.",
  "author": "Logos Core Team",
  "main": "monerod_module_plugin",
  "codegen": { "impl_header": "monerod_module_impl.h", "impl_class": "MonerodModuleImpl" },
  "dependencies": [],
  "include": ["LICENSE.monero", "LICENSE.monero_c"],
  "capabilities": [],
  "nix": {
    "packages": { "build": [], "runtime": ["nlohmann_json"] },
    "external_libraries": [ { "name": "monerod_c" } ],
    "cmake": { "extra_include_dirs": ["lib"] }
  }
}
